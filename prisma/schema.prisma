generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES_MANAGER
  SALES
}

enum ShipmentDirection {
  IMPORT
  EXPORT
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  customers Customer[]
  providers Provider[]
}

model User {
  id             String       @id @default(cuid())
  authUserId     String       @unique
  name           String
  organizationId String
  role           Role         @default(SALES)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id],onDelete: Cascade)

  @@index([organizationId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String

  companyName    String
  industrialZone String?
  location       String?
  address        String?
  commodity      String?
  contactPerson  String?
  cellPhone      String?
  email          String?

  organization Organization @relation(fields: [organizationId],references: [id],onDelete: Cascade)

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Shipment {
  id          String            @id @default(cuid())
  customerId  String
  name        String
  direction   ShipmentDirection
  commodity   String?

  customer Customer @relation(fields: [customerId],references: [id],onDelete: Cascade)

  rates ShipmentRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model Provider {
  id             String   @id @default(cuid())
  organizationId String
  name           String

  organization Organization @relation(fields: [organizationId],references: [id],onDelete: Cascade)

  shipmentRates ShipmentRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@unique([organizationId, name])
}

model ShipmentRate {
  id         String @id @default(cuid())
  shipmentId String
  providerId String

  shipment Shipment @relation(fields: [shipmentId],references: [id],onDelete: Cascade)

  provider Provider @relation(fields: [providerId],references: [id],onDelete: Cascade)

  freightItems FreightItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
  @@index([providerId])
  @@unique([shipmentId, providerId])
}

model FreightItem {
  id             String @id @default(cuid())
  shipmentRateId String

  freight  String
  unit     String?
  net      Decimal
  quantity Decimal
  gross    Decimal
  profit   Decimal
  currency String

  shipmentRate ShipmentRate @relation(fields: [shipmentRateId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentRateId])
}

